# Copy to .env.production on the deployment host; never commit actual secrets.
NODE_ENV=production
PORT=3000
# Exact public HTTPS origin: no trailing slash, path, or localhost URL.
CLIENT_ORIGIN=https://jovanstosic.dev
# One trusted host Nginx proxy; the app port must remain loopback-only.
# Change this deliberately if your proxy topology differs.
TRUST_PROXY_HOPS=1
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Required: at least 32 characters. Do not reuse a sample or the value 'dev'.
JWT_SECRET=

# Use the existing database's actual reachable hostname and credentials.
PGHOST=
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=

GMAIL_USER=
GMAIL_APP_PASSWORD=

# Optional Zipline resource settings. Defaults shown; values are positive integers.
# Time values are milliseconds and byte values are plaintext bytes.
# The 5 MiB per-file ceiling is fixed in the shared protocol, not increased here.
# ZIP_SOCKETS_PER_IP=6
# ZIP_WAITING_PER_IP=3
# ZIP_ROOMS=100
# ZIP_SOCKETS=200
# ZIP_CREATIONS_PER_MINUTE=5
# ZIP_JOINS_PER_MINUTE=10
# ZIP_WRONG_ATTEMPTS=5
# ZIP_WAITING_MS=600000
# ZIP_IDLE_MS=1800000
# ZIP_LIFETIME_MS=7200000
# ZIP_BYTE_WINDOW=600000
# ZIP_BYTES_PER_WINDOW=20971520
# ZIP_TRANSFER_MS=120000
# ZIP_ACK_MS=10000
