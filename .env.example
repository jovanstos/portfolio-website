# Local development. Copy to .env and fill in your existing service credentials.
NODE_ENV=development
PORT=3000
CLIENT_ORIGIN=http://localhost:5174
TRUST_PROXY_HOPS=0
# Use a random secret locally too; production requires at least 32 characters.
JWT_SECRET=

# Existing PostgreSQL database; containers cannot reach the host via localhost.
PGHOST=localhost
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=

# Gmail app password, not your regular account password.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Zipline uses the current origin and Vite's /socket.io proxy.
# VITE_SOCKET_URL and USE_HTTPS are no longer used.
